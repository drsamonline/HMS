# ============================================================
# HHMS Environment Configuration
# ============================================================
# Copy this file to:
#
#     .env
#
# Then replace every required placeholder with real values.
#
# NEVER commit .env to Git.
# ============================================================


# ============================================================
# Application
# ============================================================

APP_NAME=Hospital Homoeopathic Management System
APP_SHORT_NAME=HHMS
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false


# ============================================================
# Security
# ============================================================
# Generate a strong random value for production.
# Never commit the real SECRET_KEY.

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ============================================================
# Database
# ============================================================
# Development PostgreSQL example:
#
# postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE
#
# Replace all values with your actual database credentials.

DATABASE_URL=postgresql+asyncpg://hhms_user:CHANGE_ME@localhost:5432/hhms
DATABASE_ECHO=false


# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_FILE_NAME=hhms.log


# ============================================================
# CORS
# ============================================================
# JSON list because this is a Pydantic list[str] setting.

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]


# ============================================================
# Pagination
# ============================================================

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100


# ============================================================
# Hospital
# ============================================================

HOSPITAL_NAME=Hospital Homoeopathic Management System
HOSPITAL_CODE=HHMS
TIME_ZONE=Asia/Kolkata
DATE_FORMAT=%Y-%m-%d
DATETIME_FORMAT=%Y-%m-%d %H:%M:%S